  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b45406bfb7bcd8f4297e9c7bc7130472, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  player: {fileID: 0}
  anomalyObserver: {fileID: 808529327601629604}
  room: {fileID: 1368566204887573672}
  panel: {fileID: 0}
  messageText: {fileID: 0}
  promptText: {fileID: 0}
  popDuration: 0.25
  lookThreshold: 150
  feedbackSeconds: 4
  correctMessage: 'Correct! That door leads to the next level.

    From here on,
    nothing will tell you whether a room has an anomaly. It is up to you to spot
    it.'
  wrongMessage: 'Wrong door! In the real game, choosing wrongly sends you back to
    the start of the room, just like now.

    Look again and try the other door.'
  steps:
  - message: 'Welcome to Hall Pass.

      In this game you need to go through all
      the rooms and detect if anything changes.'
    prompt: Press W to start
    goal: 0
    minDisplayTime: 2
  - message: 'Good! Use W, A, S and D to walk around the room.

      Now move your
      mouse to look around.'
    prompt: Move the mouse to look around
    goal: 1
    minDisplayTime: 1.5
  - message: 'Now that you have learnt how to move and look around, try looking around
      for something that looks different.

      There IS an anomaly in this room.
      In the real game, nothing will tell you.'
    prompt: Find what has changed
    goal: 2
    minDisplayTime: 1
  - message: 'You found an anomaly!

      When a room has an anomaly, walk through
      the ANOMALY door. If nothing has changed, take the NO CHANGE door.'
    prompt: Walk through the anomaly door
    goal: 3
    minDisplayTime: 0
